# Line endings are LF everywhere, working tree included: development happens on
# Windows and CI on Linux, and without this the tree is platform-dependent.
* text=auto eol=lf

# The distribution tarball carries consumption, not development. This file is
# per-variant because what counts as "development" is: a package that ships
# configuration distributes the very .dist files a library hides.
/.github/                export-ignore
/.githooks/              export-ignore
/.gitleaks.toml          export-ignore
/.rak200                 export-ignore
/.gitmodules             export-ignore
/tests/                  export-ignore
/docs/                   export-ignore
/stories/                export-ignore
/.storybook/             export-ignore
/.editorconfig           export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore
/.git-blame-ignore-revs  export-ignore
/.coverage-floor         export-ignore
/CLAUDE.md               export-ignore
/ROADMAP.md              export-ignore
/ARCHITECTURE.md         export-ignore

# npm packs from package.json's `files`, not from export-ignore — this list governs
# `git archive` only: GitHub's source tarballs and zips. **A git-dependency
# consumer does not receive this list either.** npm clones the repository, runs
# `prepare` and packs by `files`, so a git install ships what a registry install
# ships. Measured on `npm install github:rak200/coding-standard-ts`, where
# `CHANGELOG.md` — hidden by no export-ignore line — was absent from the install.
# Keep the two lists saying the same thing anyway: the tarball a human downloads
# should not disagree with what npm installs about what this package is.
# rak200/workflow#65
/tsconfig.json                  export-ignore
/tsconfig.build.json            export-ignore
/eslint.config.js               export-ignore
/prettier.config.js             export-ignore
/vitest.config.js               export-ignore
/stryker.config.js              export-ignore
/.prettierignore                export-ignore
/release-please-config.json     export-ignore
/.release-please-manifest.json  export-ignore
